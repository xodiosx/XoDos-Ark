    <string name="you_cannot_remove_this_preset">无法移除此预设</string>
    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> 是 DirectX 1-11 到 OpenGL 的转换层。<br /><br />
        <i><b>DXVK</b></i> 是 Direct3D 9-11 到 Vulkan 的转换层。<br /><br />
        <i><b>D8VK</b></i> 是 Direct3D 8 到 Vulkan 的转换层。<br /><br />
        <i><b>CNC DDraw</b></i> 是 DirectDraw 的实现，用于更好地兼容经典游戏。
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        在 CALL/RET 操作码上处理标志<br /><br />
        <b>0</b> : 将 CALL/RET 视为永不需要标志（更快，不稳定）<br />
        <b>1</b> : 大多数 RET 需要标志，大多数 CALL 不需要<br />
        <b>2</b> : 所有 CALL/RET 都需要标志（更慢）
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_fastnan">像在 x86 上一样生成 -NAN</string>
    <string name="box86_64_env_var_help__dynarec_fastround">生成精确的 x86 舍入</string>
    <string name="box86_64_env_var_help__dynarec_x87double">使用 Float/Double 进行 x86 仿真</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec BigBlock 构建<br /><br />
        <b>0</b> : 不要尝试尽可能构建大块<br />
        <b>1</b> : 尽可能构建大的 Dynarec 块<br />
        <b>2</b> : 构建更大的 Dynarec 块（当块重叠时继续，仅适用于 elf 内存中的块）<br />
        <b>3</b> : 构建更大的 Dynarec 块（当块重叠时继续，适用于所有类型的内存）
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        模拟 Strong Memory 模型<br /><br />
        <b>0</b> : 不尝试任何特殊处理<br />
        <b>1</b> : 在某些 MOV 操作码写入内存时启用一些 Memory Barrier<br />
        <b>2</b> : 所有 1 加上使用 MOV 写入内存时每次都加 Memory Barrier<br />
        <b>2</b> : 所有 2 加上从内存读取和某些 SSE/SSE2 操作码时加 Memory Barrier
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_forward">定义构建 Block 时允许的最大前向值</string>
    <string name="box86_64_env_var_help__dynarec_callret">CALL/RET 操作码优化</string>
    <string name="box86_64_env_var_help__dynarec_wait">定义 Dynarec 是否等待 FillBlock 就绪</string>
