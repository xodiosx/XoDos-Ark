    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> DirectX 1-11 se OpenGL ke liye translation layer hai.<br /><br />
        <i><b>DXVK</b></i> Direct3D 9-11 se Vulkan ke liye translation layer hai.<br /><br />
        <i><b>D8VK</b></i> Direct3D 8 se Vulkan ke liye translation layer hai.<br /><br />
        <i><b>CNC DDraw</b></i> classic games ke saath behtar compatibility ke liye DirectDraw ka implementation hai.
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        CALL/RET opcodes par flags ka handling<br /><br />
        <b>0</b> : CALL/RET ko aise treat karta hai jaise flags kabhi zaroori nahi (faster, unstable)<br />
        <b>1</b> : Zyada RET ko flags chahiye honge, zyada CALLS ko nahi<br />
        <b>2</b> : Sabhi CALL/RET ko flags chahiye honge (slower)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_fastnan">x86 ki tarah -NAN ka generation</string>
    <string name="box86_64_env_var_help__dynarec_fastround">Precise x86 rounding ka generation</string>
    <string name="box86_64_env_var_help__dynarec_x87double">x86 emulation ke liye Float/Double ka use</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec BigBlock building<br /><br />
        <b>0</b> : Block ko jitna bada possible ho banane ki koshish na karein<br />
        <b>1</b> : Dynarec block ko jitna bada possible ho banayein<br />
        <b>2</b> : Dynarec block bigger banayein (jab block overlap ho to continue karein, sirf elf memory ke blocks ke liye)<br />
        <b>3</b> : Dynarec block bigger banayein (jab block overlap ho to continue karein, sabhi types ki memory ke liye)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        Strong Memory model ka simulation<br /><br />
        <b>0</b> : Kuch special try na karein<br />
        <b>1</b> : Memory mein likhte waqt kuch Memory Barrier enable karein (kuch MOV opcode par)<br />
        <b>2</b> : Sab 1 plus MOV use karke memory mein har write par Memory Barrier<br />
        <b>2</b> : Sab 2 plus memory se read karte waqt aur kuch SSE/SSE2 opcodes par Memory Barrier
    ]]></string>
