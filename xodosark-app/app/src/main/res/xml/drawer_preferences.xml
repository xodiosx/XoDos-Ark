<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Original Termux X11 Settings -->
    <PreferenceCategory android:title="Settings">
        <Preference
            android:key="full_settings"
            android:title="@string/notification_open_preferences"
            android:icon="@android:drawable/ic_menu_preferences"
            android:summary="Open x11 settings interface" />
    </PreferenceCategory>

    <!-- Quick Actions -->
    <PreferenceCategory android:title="Quick Actions">
        <Preference
            android:key="open_keyboard"
            android:title="@string/open_keyboard_btn"
            android:icon="@android:drawable/ic_menu_set_as"
            android:summary="Toggle software keyboard" />
            
          <SwitchPreferenceCompat
    android:key="gamepadSdlEnabled"
    android:title="Route controller to SDL gamepad"
    android:summary="When off, controller keys go to WinHandler (Wine) as before"
    android:defaultValue="false"/>

<SwitchPreferenceCompat
    android:key="gamepadForwardX11"
    android:title="Forward X11 input back to Android"
    android:defaultValue="true"
    android:dependency="gamepadSdlEnabled"/>

<EditTextPreference
    android:key="gamepadHost"
    android:title="Host"
    android:defaultValue="127.0.0.1"
    android:dependency="gamepadSdlEnabled"/>

<EditTextPreference
    android:key="gamepadPortRumble"
    android:title="Client port (server = port + 1)"
    android:defaultValue="4600"
    android:dependency="gamepadSdlEnabled"/>

        <Preference
            android:key="select_controller"
            android:title="@string/select_controller"
            android:icon="@drawable/icon_menu_game_pad_open_shape"
            android:summary="@string/select_controller_summary" />
            <Preference
    android:key="open_progress_manager"
    android:title="@string/task_manager"
    android:icon="@drawable/icon_menu_show_task_manager"
    android:summary="Managing tasks and processes" />
            
        <SwitchPreferenceCompat
    android:key="hud_enabled"
    android:title="Enable HUD"
    android:summary="Show FPS, CPU, memory overlay"
    android:defaultValue="false"
    app:iconSpaceReserved="false" />

            
        <Preference
            android:key="start_debug"
            android:title="@string/log_level_debug"
            android:icon="@android:drawable/ic_menu_info_details"
            android:summary="Start debugging-logs saved to App's Data folder" />
    </PreferenceCategory>

    <!-- Info & Actions -->
    <PreferenceCategory android:title="Information">
        <Preference
            android:key="help"
            android:title="@string/help_button_text"
            android:icon="@android:drawable/ic_menu_help"
            android:summary="Open help GitHub" />
            
        <Preference
            android:key="exit"
            android:title="@string/exit_button_exit_app"
            android:icon="@android:drawable/ic_menu_close_clear_cancel"
            android:summary="Exit the application" />
    </PreferenceCategory>

</PreferenceScreen>