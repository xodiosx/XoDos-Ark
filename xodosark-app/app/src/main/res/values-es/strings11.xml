    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> es una capa de traducción de DirectX 1-11 a OpenGL.<br /><br />
        <i><b>DXVK</b></i> es una capa de traducción de Direct3D 9-11 a Vulkan.<br /><br />
        <i><b>D8VK</b></i> es una capa de traducción de Direct3D 8 a Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> es una implementación de DirectDraw para una mejor compatibilidad con juegos clásicos.
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        Manejo de flags en opcodes CALL/RET<br /><br />
        <b>0</b> : Trata CALL/RET como si nunca necesitara flags (más rápido, inestable)<br />
        <b>1</b> : La mayoría de RET necesitarán flags, la mayoría de CALL no<br />
        <b>2</b> : Todos los CALL/RET necesitarán flags (más lento)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_fastnan">Generación de -NAN como en x86</string>
    <string name="box86_64_env_var_help__dynarec_fastround">Generación de redondeo x86 preciso</string>
    <string name="box86_64_env_var_help__dynarec_x87double">Uso de Float/Double para emulación x86</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        Construcción de BigBlock de Dynarec<br /><br />
        <b>0</b> : No intentar construir bloque lo más grande posible<br />
        <b>1</b> : Construir bloque Dynarec lo más grande posible<br />
        <b>2</b> : Construir bloque Dynarec más grande (continuar cuando el bloque se solape, solo para bloques en memoria elf)<br />
        <b>3</b> : Construir bloque Dynarec más grande (continuar cuando el bloque se solape, para todos los tipos de memoria)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        Simulación de modelo Strong Memory<br /><br />
        <b>0</b> : No intentar nada especial<br />
        <b>1</b> : Activar alguna Memory Barrier al escribir en memoria (en algún opcode MOV)<br />
        <b>2</b> : Todo 1 más una Memory Barrier en cada escritura en memoria usando MOV<br />
        <b>2</b> : Todo 2 más Memory Barrier al leer de memoria y en algunos opcodes SSE/SSE2
    ]]></string>
