    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> est une couche de traduction de DirectX 1-11 vers OpenGL.<br /><br />
        <i><b>DXVK</b></i> est une couche de traduction de Direct3D 9-11 vers Vulkan.<br /><br />
        <i><b>D8VK</b></i> est une couche de traduction de Direct3D 8 vers Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> est une implémentation de DirectDraw pour une meilleure compatibilité avec les jeux classiques.
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        Gestion des flags sur les opcodes CALL/RET<br /><br />
        <b>0</b> : Traite CALL/RET comme si les flags n’étaient jamais nécessaires (plus rapide, instable)<br />
        <b>1</b> : La plupart des RET auront besoin des flags, la plupart des CALLS non<br />
        <b>2</b> : Tous les CALL/RET auront besoin des flags (plus lent)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_fastnan">Génération de -NAN comme sur x86</string>
    <string name="box86_64_env_var_help__dynarec_fastround">Génération d’un arrondi x86 précis</string>
    <string name="box86_64_env_var_help__dynarec_x87double">Utilisation de Float/Double pour l’émulation x86</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        Construction de BigBlock dans Dynarec<br /><br />
        <b>0</b> : Ne pas essayer de construire un bloc aussi grand que possible<br />
        <b>1</b> : Construire le bloc Dynarec aussi grand que possible<br />
        <b>2</b> : Construire un bloc Dynarec plus grand (continuer quand le bloc se chevauche, uniquement pour les blocs en mémoire elf)<br />
        <b>3</b> : Construire un bloc Dynarec plus grand (continuer quand le bloc se chevauche, pour tous les types de mémoire)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        Simulation du modèle Strong Memory<br /><br />
        <b>0</b> : Ne rien tenter de spécial<br />
        <b>1</b> : Activer quelques Memory Barrier lors de l’écriture en mémoire (sur certains opcodes MOV)<br />
        <b>2</b> : Tout de 1 plus une Memory Barrier sur chaque écriture en mémoire via MOV<br />
        <b>2</b> : Tout de 2 plus Memory Barrier lors de la lecture de la mémoire et sur certains opcodes SSE/SSE2
    ]]></string>
