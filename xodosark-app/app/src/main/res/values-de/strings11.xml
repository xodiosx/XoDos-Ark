    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> ist eine Übersetzungsschicht für DirectX 1-11 zu OpenGL.<br /><br />
        <i><b>DXVK</b></i> ist eine Übersetzungsschicht für Direct3D 9-11 zu Vulkan.<br /><br />
        <i><b>D8VK</b></i> ist eine Übersetzungsschicht für Direct3D 8 zu Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> ist eine DirectDraw-Implementierung für bessere Kompatibilität mit klassischen Spielen.
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        Behandlung von Flags bei CALL/RET-Opcodes<br /><br />
        <b>0</b> : CALL/RET wird behandelt, als ob es niemals Flags bräuchte (schneller, instabil)<br />
        <b>1</b> : Die meisten RET benötigen Flags, die meisten CALL nicht<br />
        <b>2</b> : Alle CALL/RET benötigen Flags (langsamer)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_fastnan">Erzeugung von -NAN wie auf x86</string>
    <string name="box86_64_env_var_help__dynarec_fastround">Erzeugung von präzisem x86-Runden</string>
    <string name="box86_64_env_var_help__dynarec_x87double">Verwendung von Float/Double für x86-Emulation</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        Dynarec-BigBlock-Aufbau<br /><br />
        <b>0</b> : Kein möglichst großer Block erzeugen<br />
        <b>1</b> : Dynarec-Block so groß wie möglich erzeugen<br />
        <b>2</b> : Größeren Dynarec-Block erzeugen (fortsetzen bei Blocküberlappung, nur für Blöcke im ELF-Speicher)<br />
        <b>3</b> : Größeren Dynarec-Block erzeugen (fortsetzen bei Blocküberlappung, für alle Speichertypen)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        Simulation des Strong-Memory-Modells<br /><br />
        <b>0</b> : Nichts Besonderes versuchen<br />
        <b>1</b> : Einige Memory Barriers beim Schreiben in den Speicher aktivieren (bei einigen MOV-Opcodes)<br />
        <b>2</b> : Alles aus 1 plus Memory Barrier bei jedem Schreiben in den Speicher per MOV<br />
        <b>2</b> : Alles aus 2 plus Memory Barrier beim Lesen aus dem Speicher und bei einigen SSE/SSE2-Opcodes
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_forward">Definiert den max. erlaubten Vorwärtswert beim Blockaufbau</string>
