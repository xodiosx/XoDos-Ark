    <string name="dxwrapper_help_content"><![CDATA[
        <i><b>WineD3D</b></i> é uma camada de tradução de DirectX 1-11 para OpenGL.<br /><br />
        <i><b>DXVK</b></i> é uma camada de tradução de Direct3D 9-11 para Vulkan.<br /><br />
        <i><b>D8VK</b></i> é uma camada de tradução de Direct3D 8 para Vulkan.<br /><br />
        <i><b>CNC DDraw</b></i> é uma implementação de DirectDraw para melhor compatibilidade com jogos clássicos.
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_safeflags"><![CDATA[
        Tratamento de flags em opcodes CALL/RET<br /><br />
        <b>0</b> : Trata CALL/RET como se nunca precisasse de flags (mais rápido, instável)<br />
        <b>1</b> : A maioria dos RET precisará de flags, a maioria dos CALLS não<br />
        <b>2</b> : Todos os CALL/RET precisarão de flags (mais lento)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_fastnan">Geração de -NAN como no x86</string>
    <string name="box86_64_env_var_help__dynarec_fastround">Geração de arredondamento x86 preciso</string>
    <string name="box86_64_env_var_help__dynarec_x87double">Uso de Float/Double para emulação x86</string>
    <string name="box86_64_env_var_help__dynarec_bigblock"><![CDATA[
        Construção de BigBlock no Dynarec<br /><br />
        <b>0</b> : Não tentar construir bloco o maior possível<br />
        <b>1</b> : Construir bloco Dynarec o maior possível<br />
        <b>2</b> : Construir bloco Dynarec maior (continuar quando o bloco se sobrepõe, apenas para blocos em memória elf)<br />
        <b>3</b> : Construir bloco Dynarec maior (continuar quando o bloco se sobrepõe, para todos os tipos de memória)
    ]]></string>
    <string name="box86_64_env_var_help__dynarec_strongmem"><![CDATA[
        Simulação de modelo Strong Memory<br /><br />
        <b>0</b> : Não tentar nada especial<br />
        <b>1</b> : Ativar algumas Memory Barrier ao escrever na memória (em alguns opcodes MOV)<br />
        <b>2</b> : Tudo de 1 mais Memory Barrier em cada escrita na memória usando MOV<br />
        <b>2</b> : Tudo de 2 mais Memory Barrier ao ler da memória e em alguns opcodes SSE/SSE2
    ]]></string>
